MAX_TSP_NODES: int

def sieve(n: int) -> list[int]:
    """Return all primes less than or equal to n in ascending order.

    Uses the Sieve of Eratosthenes implemented in C++.

    Raises:
        ValueError: if n is negative.
        TypeError: if n is not an int.
    """

class _TspModel:
    def __init__(self, num_nodes: int, depot: int = 0) -> None: ...
    @property
    def num_nodes(self) -> int: ...
    @property
    def depot(self) -> int: ...
    def set_depot(self, depot: int) -> None: ...
    def set_distance(self, from_node: int, to_node: int, distance: int) -> None: ...
    def set_distance_matrix(self, distance_matrix: list[list[int]]) -> None: ...
    def solve(self) -> tuple[list[int], int]: ...
